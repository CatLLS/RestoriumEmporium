  m_Script: {fileID: 11500000, guid: f8c5abdcf0891a14e869965abfc32773, type: 3}
  m_Name: pt-BR
  m_EditorClassIdentifier: RestoriumEmporium.Runtime::RestoriumEmporium.Localization.LocaleTable
  localeCode: pt-BR
  displayName: "Portugu\xEAs (Brasil)"
  entries:
  - key: ui.title.newGame
    value: Novo jogo
  - key: ui.title.continue
    value: Continuar
  - key: ui.title.settings
    value: Ajustes
  - key: ui.title.quit
    value: Sair
  - key: ui.journal.title
    value: "Di\xE1rio de restaura\xE7\xF5es"
  - key: ui.journal.restore
    value: Restaurar
  - key: ui.journal.changePages
    value: "Toque para mudar de p\xE1gina"
  - key: ui.journal.locked
    value: Em breve
  - key: ui.journal.complete
    value: "Conclu\xEDdo"
  - key: ui.cleaning.title
    value: Hora de limpar!
  - key: ui.cleaning.toolbar
    value: Ferramentas de limpeza
  - key: ui.linenBacking.title
    value: "Refor\xE7o de linho"
  - key: ui.linenBacking.toolbar
    value: "Ferramentas de refor\xE7o"
  - key: ui.finishedRepair.title
    value: "Restaura\xE7\xE3o conclu\xEDda!"
  - key: ui.finishedRepair.continue
    value: Continuar
  - key: ui.finishedRepair.backToWorkbench
    value: Voltar para a bancada
  - key: ui.dialogue.tapToContinue
    value: toque para continuar
  - key: ui.dialogue.advance
    value: "Toque para avan\xE7ar o di\xE1logo"
  - key: ui.pause.title
    value: JOGO PAUSADO
  - key: ui.pause.resume
    value: Voltar ao jogo
  - key: ui.pause.quit
    value: Sair
  - key: ui.thanks.title
    value: O fim?
  - key: ui.thanks.body
    value: "Obrigada por testar o jogo! Pe\xE7o desculpas por ser t\xE3o curto, estamos
      em fase de desenvolvimento e ainda acertando os aspectos chave da gameplay.
      Em atualiza\xE7\xF5es futuras traremos mais posters e uma hist\xF3ria misteriosa
      para voc\xEAs! Enquanto espera desenvolvermos mais do jogo, que tal mandar
      um feedback do que achou do jogo? encontrou algum bug? tem alguma ideia de
      como melhorar a gameplay? Sou toda ouvidos!"
  - key: ui.thanks.continue
    value: Continuar
  - key: tool.dustRemover
    value: Espanador
  - key: tool.waterSpray
    value: Borrifador
  - key: tool.deacidifier
    value: Desacidificante
  - key: tool.squeegee
    value: Rodo
  - key: tool.roller
    value: Rolo de cola
  - key: tool.pencil
    value: "L\xE1pis"
  - key: poster.poster01.title
    value: Visite Lethe Falls
  - key: stage.dust.title
    value: Tirando a poeira
  - key: stage.dust.prompt
    value: "Passe o espanador por todo o cartaz at\xE9 a poeira sumir."
  - key: stage.wash.title
    value: Lavagem
  - key: stage.wash.prompt
    value: "Borrife \xE1gua e cubra o cartaz inteirinho."
  - key: stage.deacidify.title
    value: "Desacidifica\xE7\xE3o"
  - key: stage.deacidify.prompt
    value: Espalhe o desacidificante para o papel voltar a ser branco.
  - key: stage.squeegee.title
    value: Hora de secar
  - key: stage.squeegee.prompt
    value: "Deslize o rodo de um lado ao outro para tirar a \xE1gua."
  - key: stage.adhesive.title
    value: Rolando, rolando!
  - key: stage.adhesive.prompt
    value: Passe o rolo com cola por todo o verso do cartaz.
  - key: stage.mend.title
    value: Retoques finais
  - key: stage.mend.prompt
    value: "Use o l\xE1pis para completar os pedacinhos que faltam."
  - key: tutorial.welcome
    value: "Oi, oi! Que bom te ver por aqui. Eu sou a Tracy, e este \xE9 o Restorium
      Emporium. Vamos devolver a vida a um cartaz bem antigo?"
  - key: tutorial.tapRestore
    value: "Nosso primeiro trabalho est\xE1 aqui no di\xE1rio. Toque em Restaurar
      para come\xE7armos."
  - key: tutorial.pickDustRemover
    value: Primeiro, a poeira. Pegue o espanador ali na barra de ferramentas.
  - key: tutorial.useDustRemover
    value: "Agora deslize o dedo pelo cartaz, devagarinho, at\xE9 tirar toda a poeira."
  - key: tutorial.pickWaterSpray
    value: "Muito bem! Agora pegue o borrifador de \xE1gua."
  - key: tutorial.useWaterSpray
    value: "Umede\xE7a o cartaz inteiro. Sem pressa, o papel agradece."
  - key: tutorial.pickDeacidifier
    value: O papel amarelou com o tempo. Pegue o desacidificante para a gente resolver
      isso.
  - key: tutorial.useDeacidifier
    value: "Espalhe por tudo e veja o branquinho voltar. Essa \xE9 a minha parte
      favorita."
  - key: tutorial.pickSqueegee
    value: Hora de secar. Pegue o rodo, por favor.
  - key: tutorial.useSqueegee
    value: "Deslize o rodo de um lado ao outro para tirar a \xE1gua que sobrou."
  - key: tutorial.pickRoller
    value: "Virei o cartaz para voc\xEA. Agora pegue o rolo de cola."
  - key: tutorial.useRoller
    value: "Passe cola por todo o verso \u2014 \xE9 ela que vai segurar o cartaz
      no linho."
  - key: tutorial.pickPencil
    value: "Falta pouquinho! Pegue o l\xE1pis."
  - key: tutorial.usePencil
    value: Agora complete com carinho os pedacinhos que se perderam pelo caminho.
  - key: tutorial.congrats
    value: "Olha s\xF3 isso! Ficou lindo. E o trabalho rendeu umas moedinhas pra
      gente \u2014 viu ali?"
  - key: tutorial.tapContinue
    value: Toque em Continuar e vamos para a minha oficina. Quero te mostrar uma
      coisa!
  - key: ui.journal.pageHint
    value: "Aperte as setas para mudar de p\xE1gina"
  - key: ui.thanks.quit
    value: Fechar
  - key: ui.cutscene.skipHint
    value: Toque para pular
  - key: stage.stickers.title
    value: Hora de descolar!
  - key: stage.stickers.prompt
    value: "Parece que algu\xE9m j\xE1 tentou consertar este cartaz... Toque em cada
      fita para descol\xE1-la."
  - key: poster.poster01.chapter
    value: Cap. 1 - Cartaz de turismo de Lethe Falls
  - key: poster.poster02.title
    value: Cine Eternal
  - key: poster.poster02.chapter
    value: "Cap. 2 - Programa\xE7\xE3o do Cine Eternal"
  - key: ui.desk.selected
    value: 'Selecionado: {0}'
  - key: ui.desk.desc
    value: 'Desc.: {0}'
  - key: ui.edit.title
    value: "Modo de Edi\xE7\xE3o"
  - key: ui.edit.hint
    value: "Selecione um item para mudar a posi\xE7\xE3o dele."
  - key: ui.edit.dragHint
    value: "Toque e arraste o item para posicion\xE1-lo"
  - key: ui.edit.place
    value: Colocar Item
  - key: ui.edit.undo
    value: Desfazer
  - key: ui.edit.or
    value: ou
  - key: ui.edit.backToWorkshop
    value: "Voltar \xE0 oficina"
  - key: ui.preview.title
    value: "Modo de Pr\xE9via"
  - key: ui.preview.dragHint
    value: "Toque e arraste o item para posicion\xE1-lo"
  - key: ui.preview.price
    value: "Pre\xE7o: {0} moedas"
  - key: ui.preview.buy
    value: Comprar Item
  - key: ui.preview.giveUp
    value: Desistir
  - key: ui.preview.notEnoughCoins
    value: "Ainda n\xE3o tenho moedas suficientes... Restaurar outro p\xF4ster deve
      ajudar!"
  - key: ui.shop.back
    value: "Voltar \xE0 bancada"
  - key: ui.shop.titleTop
    value: "Emp\xF3rio da"
  - key: ui.shop.titleMain
    value: Tracy
  - key: ui.shop.removeAds
    value: "Remover an\xFAncios"
  - key: ui.shop.buyMoreCoins
    value: Comprar Moedas
  - key: ui.shop.tabDecor
    value: "Decora\xE7\xE3o"
  - key: ui.shop.tabMisc
    value: Diversos
  - key: ui.shop.owned
    value: Comprado
  - key: ui.shop.empty
    value: Mais itens em breve!
  - key: shop.item.lamp.name
    value: "Lumin\xE1ria"
  - key: shop.item.lamp.desc
    value: "Uma lumin\xE1ria quentinha e bem clara para a bancada. Com essa luz,
      voc\xEA nunca mais vai deixar um p\xF4ster falso passar despercebido!"
  - key: shop.item.plant.name
    value: Vaso de Planta
  - key: shop.item.plant.desc
    value: "Este vaso de planta lindinho foi encontrado numa loja perto da oficina,
      \xE9 muito bonito!"
  - key: shop.item.books.name
    value: Pilha de Livros
  - key: shop.item.books.desc
    value: "Voc\xEA come\xE7ou a ler livros de mist\xE9rio sobre viagem no tempo,
      ent\xE3o comprou uma pilha para deixar na oficina!"
  - key: ui.pause.journal
    value: "Di\xE1rio"
  - key: ui.pause.settings
    value: Ajustes
  - key: ui.pause.flavour
    value: "Sem pressa. Os mist\xE9rios por tr\xE1s destes pap\xE9is v\xE3o esperar
      a sua volta."
  - key: ui.settings.title
    value: AJUSTES
  - key: ui.settings.tracyLine
    value: Ah, o restorium precisa de uns ajustes? Foi mal, vamos mudar isso agora
      mesmo!
  - key: ui.settings.language
    value: Idioma
  - key: ui.settings.sfx
    value: Efeitos sonoros
  - key: ui.settings.music
    value: "M\xFAsica"
  - key: ui.settings.resetProgress
    value: Apagar progresso
  - key: ui.settings.resetConfirm
    value: "Apagar todo o progresso? Suas moedas, decora\xE7\xF5es e cartazes restaurados
      ser\xE3o perdidos."
  - key: ui.settings.resetYes
    value: Apagar
  - key: ui.settings.resetNo
    value: Cancelar
  - key: ui.journal.continue
    value: Continuar
  - key: ui.journal.restored
    value: Restaurado
  - key: ui.journal.back
    value: Voltar para a bancada
  - key: ui.journal.lockedHint
    value: Restaure o cartaz anterior primeiro
  - key: ui.finishedRepair.double
    value: Dobrar recompensa
  - key: ui.finishedRepair.or
    value: ou
  - key: ui.finishedRepair.coins
    value: +{0}
  - key: tutorial.deskhub_lamp.welcome
    value: "Bem-vindo \xE0 minha oficina! \xC9 aqui que a m\xE1gica acontece... bom,
      quase toda."
  - key: tutorial.deskhub_lamp.dark
    value: "Hmm... est\xE1 bem escurinho aqui nessa mesa, n\xE9? Eu preciso muito
      de uma lumin\xE1ria nova."
  - key: tutorial.deskhub_lamp.fake
    value: "Vai ver foi por isso que eu n\xE3o percebi que o \xFAltimo cartaz era
      falso... Com uma luz dessas, qualquer um deixaria passar! N\xE9?"
  - key: tutorial.deskhub_lamp.tapShop
    value: Vamos escolher uma! Toque na bolsa para abrir a loja.
  - key: tutorial.deskhub_lamp.tapLamp
    value: "Ah, essa lumin\xE1ria \xE9 perfeita \u2014 e as moedas que voc\xEA acabou
      de ganhar pagam certinho. Toque nela!"
  - key: tutorial.deskhub_lamp.drag
    value: "Olha s\xF3 como ficaria! Arraste para onde quiser na mesa."
  - key: tutorial.deskhub_lamp.buy
    value: "Gostou do lugar? Toque em Comprar item e ela \xE9 nossa!"
  - key: tutorial.deskhub_lamp.happy
    value: Bem melhor! Agora sim eu consigo ver cada detalhezinho.
  - key: tutorial.deskhub_lamp.editMode
    value: "Se quiser mudar as coisas de lugar depois, \xE9 s\xF3 tocar neste bot\xE3o
      para entrar no modo de edi\xE7\xE3o."
  - key: tutorial.deskhub_lamp.tapBook
    value: "Agora vamos abrir o di\xE1rio. Toque no livro \u2014 tenho a impress\xE3o
      de que chegou trabalho novo."
  - key: tutorial.journal_page2.newPoster
    value: Olha! Chegou um cartaz novo enquanto a gente estava ocupada.
  - key: tutorial.journal_page2.nextPage
    value: "Toque na seta para virar a p\xE1gina."
  - key: tutorial.journal_page2.restore
    value: "Aqui est\xE1 ele. Toque em Restaurar quando estiver pronto."
  - key: tutorial.stickers.explain
    value: "Ai, ai, algu\xE9m encheu esse cartaz de adesivos! Vamos ter que tirar
      um por um."
  - key: tutorial.stickers.peel
    value: Toque em um adesivo para descolar. Com cuidado!
  - key: tutorial.stickers.rest
    value: Isso mesmo! Agora os outros.
  - key: ui.pause.continue
    value: Continuar
  - key: ui.coins.title
    value: O Cofre Dourado
  - key: ui.coins.pack
    value: '{0} moedas | {1}'
  - key: ui.coins.finePrint
    value: "cobrado na sua conta. Restaure compras quando quiser nas Configura\xE7\xF5es"
  - key: ui.coins.terms
    value: Termos
  - key: ui.coins.privacy
    value: Privacidade
  - key: ui.coins.removeAds
    value: "Remover an\xFAncios"
  - key: ui.coins.failed
    value: "A compra n\xE3o foi conclu\xEDda. Tente novamente."
  - key: ui.coins.unavailable
    value: "A loja n\xE3o est\xE1 dispon\xEDvel agora."
